# agentic/config — configuração dos mecanismos do framework. Preenchida no /bootstrap.
# Superfície de política: depois de ativadas as proteções, o agente não edita este arquivo.
BRANCH_PRINCIPAL="main"
BRANCHES_PROTEGIDAS="main master"
# Comando que roda build + lint + testes + arquitetura da stack (usado pelo verify.sh).
CMD_VERIFY_STACK="{{CMD_VERIFY_STACK}}"
# Opcional. Comando rápido do laço (lint e testes tocados). Vazio = o verify --rapido usa o CMD_VERIFY_STACK.
CMD_VERIFY_RAPIDO="{{CMD_VERIFY_RAPIDO}}"
# Comando que roda só os testes (usado pelo verifica-red.sh no commit RED).
CMD_TESTE="{{CMD_TESTE}}"
# Opcional: comando que roda só UM arquivo/classe de teste; {} é trocado pelo caminho relativo do arquivo
# (ex.: npx jest {}, python -m pytest {}, node --test {}). Usado pelo verifica-red.sh para provar que CADA
# arquivo de teste do RED falhava. Java/Maven (mvn -q test -Dtest={}) espera nome de classe, não caminho:
# use um wrapper que converta caminho em classe, ou deixe vazio. Vazio = degradado (RED provado pela suíte).
CMD_TESTE_ARQUIVO="{{CMD_TESTE_ARQUIVO}}"
# Opcional: executores por caminho, para projeto com mais de um executor de testes (monorepo). Cada bloco
# TESTE_<n>_* (n = 1, 2, …, sem buraco: a leitura para no primeiro n sem PADROES) diz que arquivos são dele e
# como prová-los; o primeiro bloco cujo padrão casa com o arquivo é o executor dele. Arquivo sem executor cai no
# CMD_TESTE_ARQUIVO e, sem ele, na suíte inteira (CMD_TESTE), uma vez por RED.
#   TESTE_<n>_PADROES  padrões do case do sh, separados por espaço (o * cruza /). Também marcam o arquivo como
#                      teste, o que cobre o teste colocalizado (*.spec.ts ao lado da produção).
#   TESTE_<n>_PREPARO  opcional; roda uma vez no worktree do RED, só quando o RED toca arquivo desse executor.
#   TESTE_<n>_COMANDO  roda na raiz do worktree; {} = caminho do arquivo, {classe} = nome JVM (package + nome).
#   TESTE_<n>_RC_RED   opcional; vazio = qualquer código fora de 0, 126 e 127 é RED; preenchido, só esse código
#                      é RED e outro código diferente de zero bloqueia. Com a ajuda red-junit.sh, use "1": ela lê
#                      o JUnit XML e separa "um teste falhou" (1) de "nada rodou" (126: compilação, coleta, zero casos).
# Exemplo — um executor de arquivo e um por módulo:
#   TESTE_1_PADROES="frontend/src/*.spec.ts"
#   TESTE_1_PREPARO="npm ci --ignore-scripts --prefix frontend"
#   TESTE_1_COMANDO="cd frontend && npx ng test --include={}"
#   TESTE_2_PADROES="backend/bridge/src/test/*.kt"
#   TESTE_2_COMANDO="sh agentic/mecanismos/scripts/red-junit.sh 'backend/bridge/build/test-results/test/*.xml' -- backend/gradlew -p backend :bridge:test --tests {classe}"
#   TESTE_2_RC_RED="1"
# Preparação necessária num worktree limpo antes de testar (ex.: npm ci). Vazio se não houver.
CMD_PREPARAR_TESTE="{{CMD_PREPARAR_TESTE}}"
# Diretórios de teste, separados por espaço, com barra final.
DIRS_TESTE="{{DIRS_TESTE}}"
# Regex (ERE) que identifica teste desabilitado na stack. Vazio = verificação degradada.
MARCADOR_DESABILITADO="{{MARCADOR_DESABILITADO}}"
# Regex (ERE) que identifica uma asserção nos testes.
MARCADOR_ASSERCAO="{{MARCADOR_ASSERCAO}}"
# Glob dos relatórios JUnit XML gerados pelo CMD_VERIFY_STACK. Vazio = verificação degradada.
RELATORIO_TESTES="{{RELATORIO_TESTES}}"
GITLEAKS_BIN="gitleaks"
# Opcional. Vazio = checagem pulada com aviso. Comando que valida o contrato executável (esqueleto compila,
# arquitetura respeitada), rodado na raiz do worktree pelo verifica-artefato.sh antes do Gate 1.
CMD_VALIDA_CONTRATO="{{CMD_VALIDA_CONTRATO}}"
# Opcional. Vazio = checagem pulada com aviso. Globs separados por espaço dos caminhos que são gatilho N3:
# arquivo de task ou mudança que casa com um deles exige item N3 citado.
CAMINHOS_N3="{{CAMINHOS_N3}}"
