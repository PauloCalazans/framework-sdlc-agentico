{
  "agentic": {
    "SessionStart": [
      { "type": "command", "command": "git -c alias.agentic-sh=!sh agentic-sh .agents/hooks/inicio.sh" }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "git -c alias.agentic-sh=!sh agentic-sh .agents/hooks/guarda.sh", "timeout": 30 }
        ]
      }
    ]
  }
}
