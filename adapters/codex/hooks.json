{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "git -c alias.agentic-sh=!sh agentic-sh agentic/mecanismos/scripts/status-projeto.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          { "type": "command", "command": "git -c alias.agentic-sh=!sh agentic-sh .codex/hooks/guarda.sh", "statusMessage": "agentic: conferindo proteções" }
        ]
      }
    ]
  }
}
